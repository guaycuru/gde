{
  "autoload": {
    "psr-4": {
      "GDE\\": "classes/GDE/",
      "DAC\\": "classes/DAC/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GDE\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "doctrine/annotations": "^1.13.3",
    "doctrine/cache": "^1.12.1",
    "doctrine/orm": "^2.13.3",
    "doctrine/dbal": "^3.10.6",
    "doctrine/common": "^3.4.3",
    "symfony/cache": "~5.4.15",
    "symfony/console": "^6.4",
    "ext-bcmath": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ircmaxell/password-compat": "^1.0",
    "google/apiclient": "^2.0"
  },
  "suggest": {
    "ext-mysqli": "*",
    "ext-pdo_mysql": "*",
    "ext-redis": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration"
  }
}
