# Commit your application's lock file http://getcomposer.org/doc/01-basic-usage.md#composer-lock-the-lock-file
# You may choose to ignore a library lock file http://getcomposer.org/doc/02-libraries.md#lock-file
# composer.lock

.svn/
cache/*
!cache/.htaccess
common/config*.inc.php
common/client_secret_*.json
common/client_secret_google.bkp
common/*.pem
nbproject/
api/gen/
web/fts/*
!web/fts/nobody*.gif
42/
.DS_Store
.idea/
*.iml
proxies/*
!proxies/.htaccess
vendor/*
!vendor/.htaccess
composer.phar
errors/*
k8s/secret.yaml
.phpunit.cache/
tests/db.local.php
.composer-cache/
